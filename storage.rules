rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'dlflyoverseas@gmail.com'
        && request.auth.token.email_verified == true && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    match /media/{file} {
      allow read: if true;
      allow create, update: if isAdmin() && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
      allow delete: if isAdmin();
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
